CheckpointVisuals

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local activatedEvent = ReplicatedStorage:WaitForChild("CheckpointActivated")

activatedEvent.OnClientEvent:Connect(function(checkpoint)
	if not checkpoint or not checkpoint:IsA("BasePart") then
		return
	end

	local checkpointType = checkpoint:GetAttribute("CheckpointType")

	if checkpointType == "Zone" then
		-- Область становится полностью невидимой
		-- только для активировавшего её игрока.
		checkpoint.LocalTransparencyModifier = 1

	elseif checkpointType == "Button" then
		-- Кнопка становится зелёной только у этого игрока.
		checkpoint.Color = Color3.fromRGB(70, 255, 100)
	end
end)
