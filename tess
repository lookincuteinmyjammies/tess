CheckpointServer

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local checkpointsFolder = workspace:WaitForChild("Checkpoints")

-- Событие для изменения внешнего вида только у нужного игрока.
local activatedEvent = ReplicatedStorage:FindFirstChild("CheckpointActivated")

if not activatedEvent then
	activatedEvent = Instance.new("RemoteEvent")
	activatedEvent.Name = "CheckpointActivated"
	activatedEvent.Parent = ReplicatedStorage
end

-- Последний чекпоинт каждого игрока.
local playerCheckpoints = {}

-- Находим игрока, даже если чекпоинта коснулась
-- не часть тела, а, например, аксессуар.
local function getPlayerFromHit(hit)
	local current = hit

	while current and current ~= workspace do
		if current:IsA("Model") then
			local player = Players:GetPlayerFromCharacter(current)

			if player then
				return player, current
			end
		end

		current = current.Parent
	end

	return nil, nil
end

local function getRespawnCFrame(checkpoint)
	local checkpointType = checkpoint:GetAttribute("CheckpointType")

	if checkpointType == "Zone" then
		-- Точка внутри области, примерно на 3 studs выше её низа.
		return checkpoint.CFrame * CFrame.new(
			0,
			-checkpoint.Size.Y / 2 + 3,
			0
		)
	else
		-- Точка над кнопкой.
		return checkpoint.CFrame * CFrame.new(
			0,
			checkpoint.Size.Y / 2 + 3,
			0
		)
	end
end

local function connectCheckpoint(checkpoint)
	if not checkpoint:IsA("BasePart") then
		return
	end

	checkpoint.Touched:Connect(function(hit)
		local checkpointType = checkpoint:GetAttribute("CheckpointType")

		if checkpointType ~= "Button" and checkpointType ~= "Zone" then
			return
		end

		local player, character = getPlayerFromHit(hit)

		if not player or not character then
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if not humanoid or humanoid.Health <= 0 then
			return
		end

		-- Несколько частей тела могут коснуться детали подряд.
		-- Повторно активировать текущий чекпоинт не нужно.
		if playerCheckpoints[player] == checkpoint then
			return
		end

		playerCheckpoints[player] = checkpoint

		-- Сообщаем об активации только этому игроку.
		activatedEvent:FireClient(player, checkpoint)
	end)
end

local function onCharacterAdded(player, character)
	local rootPart = character:WaitForChild("HumanoidRootPart", 10)

	if not rootPart or player.Character ~= character then
		return
	end

	local checkpoint = playerCheckpoints[player]

	if checkpoint and checkpoint:IsDescendantOf(workspace) then
		character:PivotTo(getRespawnCFrame(checkpoint))

		-- Убираем остаточную скорость после перемещения.
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end
end

local function setupPlayer(player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

-- Подключаем существующие чекпоинты.
for _, checkpoint in checkpointsFolder:GetChildren() do
	connectCheckpoint(checkpoint)
end

-- Подключаем и те, которые добавятся во время игры.
checkpointsFolder.ChildAdded:Connect(connectCheckpoint)

Players.PlayerAdded:Connect(setupPlayer)

for _, player in Players:GetPlayers() do
	setupPlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
	playerCheckpoints[player] = nil
end)


