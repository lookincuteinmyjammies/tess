CheckpointVisuals

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local event = ReplicatedStorage:WaitForChild("CheckpointActivated")

event.OnClientEvent:Connect(function(zone)
	if not zone or not zone:IsA("BasePart") then
		return
	end

	-- Полностью скрываем зону для текущего игрока.
	zone.LocalTransparencyModifier = 1
end)
