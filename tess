CheckpointServer

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = workspace:WaitForChild("Checkpoints")

local event = ReplicatedStorage:FindFirstChild("CheckpointActivated")

if not event then
	event = Instance.new("RemoteEvent")
	event.Name = "CheckpointActivated"
	event.Parent = ReplicatedStorage
end

local checkpoints = {}

-- Находим игрока по коснувшейся части персонажа.
local function getPlayerFromHit(hit)
	local current = hit

	while current and current ~= workspace do
		if current:IsA("Model") then
			local player = Players:GetPlayerFromCharacter(current)

			if player then
				return player, current
			end
		end

		current = current.Parent
	end

	return nil, nil
end

local function connectZone(zone)
	if not zone:IsA("BasePart") then
		return
	end

	zone.Touched:Connect(function(hit)
		local player, character = getPlayerFromHit(hit)

		if not player then
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if not humanoid or humanoid.Health <= 0 then
			return
		end

		if checkpoints[player] == zone then
			return
		end

		-- Новая зона заменяет предыдущий чекпоинт.
		checkpoints[player] = zone

		-- Скрываем зону только для этого игрока.
		event:FireClient(player, zone)
	end)
end

local function onCharacterAdded(player, character)
	local root = character:WaitForChild("HumanoidRootPart", 10)

	if not root or player.Character ~= character then
		return
	end

	local zone = checkpoints[player]

	if zone and zone:IsDescendantOf(workspace) then
		-- Возрождаем в центре зоны, на 3 studs выше её низа.
		local spawnCFrame = zone.CFrame * CFrame.new(
			0,
			-zone.Size.Y / 2 + 3,
			0
		)

		character:PivotTo(spawnCFrame)

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function setupPlayer(player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

for _, zone in folder:GetChildren() do
	connectZone(zone)
end

folder.ChildAdded:Connect(connectZone)

Players.PlayerAdded:Connect(setupPlayer)

for _, player in Players:GetPlayers() do
	setupPlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
	checkpoints[player] = nil
end)


